rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function owner(uid) { return request.auth != null && request.auth.uid == uid; }
    function text(s, max) { return s is string && s.size() <= max; }
    function date(s) { return s is string && s.matches('[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])'); }
    function profile(d) {
      return d.keys().hasAll(['name','age','weight','blood','allergies','contact','phone','notifications'])
        && d.keys().hasOnly(['name','age','weight','blood','allergies','contact','phone','notifications'])
        && text(d.name,100) && d.name.size() >= 2 && text(d.age,3) && text(d.weight,6)
        && d.blood in ['', 'A+','A-','B+','B-','AB+','AB-','O+','O-']
        && text(d.allergies,1000) && text(d.contact,100) && text(d.phone,30) && d.notifications is bool;
    }
    function record(d) {
      return d.keys().hasAll(['kind','title','detail','times','start','end','place','level','reminderMinutes','dayBefore','archived'])
        && d.keys().hasOnly(['kind','title','detail','times','start','end','place','level','reminderMinutes','dayBefore','archived','stockRemaining','unitsPerDose','stockAlertAt','stockTotal','foodItems'])
        && d.kind in ['MEDICINE','APPOINTMENT','MEAL','RESTRICTION']
        && text(d.title,100) && d.title.size() > 0 && text(d.detail,1000) && text(d.place,200)
        && d.level in ['Restringido','Permitido','Prohibido','Moderado']
        && d.reminderMinutes is int && d.reminderMinutes >= 0 && d.reminderMinutes <= 10080
        && d.dayBefore is bool && d.archived is bool
        && (!d.keys().hasAny(['stockRemaining','unitsPerDose','stockAlertAt','stockTotal','foodItems'])
          || (d.keys().hasAll(['stockRemaining','unitsPerDose','stockAlertAt','stockTotal','foodItems'])
            && (d.stockRemaining == null || (d.stockRemaining is int && d.stockRemaining >= 0 && d.stockRemaining <= 100000))
            && d.unitsPerDose is int && d.unitsPerDose >= 1 && d.unitsPerDose <= 1000
            && d.stockAlertAt is int && d.stockAlertAt >= 0 && d.stockAlertAt <= 100000
            && (d.stockTotal == null || (d.stockTotal is int && d.stockTotal >= 0 && d.stockTotal <= 100000))
            && (d.stockRemaining == null || d.stockTotal == null || d.stockRemaining <= d.stockTotal)
            && text(d.foodItems,2000)))
        && date(d.start) && (d.end == '' || (date(d.end) && d.end >= d.start))
        && text(d.times,143) && d.times.matches('([01][0-9]|2[0-3]):[0-5][0-9](,([01][0-9]|2[0-3]):[0-5][0-9])*')
        && (d.kind != 'APPOINTMENT' || d.times.size() == 5)
        && (d.kind != 'MEDICINE' || d.detail.size() > 0);
    }
    match /users/{uid} {
      allow read: if owner(uid);
      allow create, update: if owner(uid) && profile(request.resource.data);
      allow delete: if false;
      match /records/{id} {
        allow read: if owner(uid);
        allow create: if owner(uid) && id.matches('[A-Za-z0-9-]{1,80}') && record(request.resource.data) && !request.resource.data.archived;
        allow update: if owner(uid) && record(request.resource.data)
          && !resource.data.archived && request.resource.data.kind == resource.data.kind;
        allow delete: if false;
      }
      match /completions/{eventId} {
        function validEvent(d) {
          let r = get(/databases/$(database)/documents/users/$(uid)/records/$(d.recordId)).data;
          let parts = d.occurrence.split('T');
          return d.keys().hasAll(['recordId','occurrence','status','at'])
            && d.keys().hasOnly(['recordId','occurrence','status','at'])
            && text(d.recordId,80) && d.occurrence is string
            && d.occurrence.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}T([01][0-9]|2[0-3]):[0-5][0-9]')
            && eventId == d.recordId + '_' + d.occurrence.replace(':','-')
            && d.status in ['TAKEN','SKIPPED'] && d.at is int && d.at > 0 && d.at <= request.time.toMillis() + 300000
            && r.kind != 'RESTRICTION' && !r.archived
            && r.times.split(',').hasAny([parts[1]]) && parts[0] >= r.start
            && (r.end == '' || parts[0] <= r.end) && (r.kind != 'APPOINTMENT' || parts[0] == r.start);
        }
        allow read: if owner(uid);
        allow create: if owner(uid) && validEvent(request.resource.data);
        // A repeated identical write is safe; changing a recorded dose is prohibited.
        allow update: if owner(uid) && request.resource.data == resource.data;
        allow delete: if false;
      }
    }
    match /{document=**} { allow read, write: if false; }
  }
}
